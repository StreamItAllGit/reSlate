# Standard 11 Outer-Root .gitignore (Track Root Quartet, AGENTS.md, *.state, and Dev\ source)
/Archive/
Builds/
Releases/
Dev/docs/*/
.agents/
Dev/logs/
Dev/data/*
!Dev/data/settings.example.json
*.pdb
.venv/
venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
bin/
obj/
.vs/
Library/
Temp/
Logs/
UserSettings/
*.tmp
*.bak
Thumbs.db
.DS_Store

# Canonical user ROM/disc preload directories
**/data/rom/
data/rom/

# T1 SDK/asset guard: never commit large bootstrap/lib EXEs; track SDK DLL/XML/deps.json + native 7-Zip tools
Dev/assets/bootstrap/*.exe
Dev/lib/*.exe
!Dev/lib/*.dll
!Dev/lib/*.xml
!Dev/lib/*.deps.json
!Dev/assets/native/
!Dev/assets/native/**

# RS-06 dev/runtime logs & OS/Drive junk
logs/
desktop.ini
ehthumbs.db
._*
