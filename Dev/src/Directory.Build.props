<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <Product>reSlate</Product>
    <Company>StreamItAll</Company>
    <Version>0.3.3</Version>
    <InformationalVersion>0.3.3</InformationalVersion>
    <FileVersion>0.3.3.0</FileVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ReStationLibDir>$(MSBuildThisFileDirectory)..\lib\</ReStationLibDir>
    <ReStationAssetsDir>$(MSBuildThisFileDirectory)..\assets\</ReStationAssetsDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(ReStationTestAutomation)' == 'true'">
    <DefineConstants>$(DefineConstants);RESTATION_TEST_AUTOMATION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))\=proj\,$(USERPROFILE)\=usr\</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
