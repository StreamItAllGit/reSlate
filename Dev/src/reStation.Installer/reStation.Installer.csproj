<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>reSlate-Setup-v$(Version)-win-x64</AssemblyName>
    <RootNamespace>reStation.Installer</RootNamespace>
    <ApplicationTitle>reSlate Setup</ApplicationTitle>
    <ApplicationIcon>..\..\assets\reSlate.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="reStation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="installer.manifest.json" LogicalName="reSlate.Installer.installer.manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Foundation.Core">
      <HintPath>$(ReStationLibDir)Foundation.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Foundation.Installer">
      <HintPath>$(ReStationLibDir)Foundation.Installer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Foundation.Retro">
      <HintPath>$(ReStationLibDir)Foundation.Retro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="reEngine.Core">
      <HintPath>$(ReStationLibDir)reEngine.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(ReStationTestAutomation)' == 'true'">
    <Reference Include="Foundation.Automation">
      <HintPath>$(ReStationLibDir)Foundation.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Foundation.UI">
      <HintPath>$(ReStationLibDir)Foundation.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Embeds Private=false SDK assemblies as .dll.gz resources resolved by Program's static AssemblyResolve handler. -->
  <Target Name="CompressEmbeddedAssemblies" BeforeTargets="AssignTargetPaths;PrepareResourceNames;PrepareResources">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$files = @('$(ReStationLibDir)Foundation.Core.dll','$(ReStationLibDir)Foundation.Installer.dll','$(ReStationLibDir)Foundation.Retro.dll','$(ReStationLibDir)reEngine.Core.dll'); $outDir = [System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'); foreach ($src in $files) { if (-not (Test-Path $src)) { throw ('Missing assembly: ' + $src) }; $name = [System.IO.Path]::GetFileName($src); $dst = Join-Path $outDir ($name + '.gz'); $bytes = [System.IO.File]::ReadAllBytes($src); $fs = [System.IO.File]::Create($dst); try { $gz = New-Object System.IO.Compression.GZipStream($fs, [System.IO.Compression.CompressionLevel]::Optimal); try { $gz.Write($bytes, 0, $bytes.Length) } finally { $gz.Dispose() } } finally { $fs.Dispose() } }&quot;" />
    <ItemGroup>
      <EmbeddedResource Remove="$(IntermediateOutputPath)Foundation.Core.dll.gz;$(IntermediateOutputPath)Foundation.Installer.dll.gz;$(IntermediateOutputPath)Foundation.Retro.dll.gz;$(IntermediateOutputPath)reEngine.Core.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Core.dll.gz" LogicalName="Foundation.Core.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Installer.dll.gz" LogicalName="Foundation.Installer.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Retro.dll.gz" LogicalName="Foundation.Retro.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)reEngine.Core.dll.gz" LogicalName="reEngine.Core.dll.gz" />
    </ItemGroup>
  </Target>

  <Target Name="CompressEmbeddedAutomationAssemblies" Condition="'$(Configuration)' == 'Debug' Or '$(ReStationTestAutomation)' == 'true'" BeforeTargets="AssignTargetPaths;PrepareResourceNames;PrepareResources">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$files = @('$(ReStationLibDir)Foundation.Automation.dll','$(ReStationLibDir)Foundation.UI.dll'); $outDir = [System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'); foreach ($src in $files) { if (-not (Test-Path $src)) { throw ('Missing assembly: ' + $src) }; $name = [System.IO.Path]::GetFileName($src); $dst = Join-Path $outDir ($name + '.gz'); $bytes = [System.IO.File]::ReadAllBytes($src); $fs = [System.IO.File]::Create($dst); try { $gz = New-Object System.IO.Compression.GZipStream($fs, [System.IO.Compression.CompressionLevel]::Optimal); try { $gz.Write($bytes, 0, $bytes.Length) } finally { $gz.Dispose() } } finally { $fs.Dispose() } }&quot;" />
    <ItemGroup>
      <EmbeddedResource Remove="$(IntermediateOutputPath)Foundation.Automation.dll.gz;$(IntermediateOutputPath)Foundation.UI.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Automation.dll.gz" LogicalName="Foundation.Automation.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.UI.dll.gz" LogicalName="Foundation.UI.dll.gz" />
    </ItemGroup>
  </Target>

  <!-- Packaging-time payload archive (passed by Dev\scripts\build_release.ps1); absent during Debug/test builds. -->
  <ItemGroup Condition="'$(InstallerPayloadZip)' != '' and Exists('$(InstallerPayloadZip)')">
    <EmbeddedResource Include="$(InstallerPayloadZip)" LogicalName="reSlate.Installer.Embedded.payload.zip" />
  </ItemGroup>

</Project>
