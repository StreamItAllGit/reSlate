<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>reStation.Decomp</AssemblyName>
    <RootNamespace>reStation.Decomp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="reStation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\r3000a_gte.slaspec" LogicalName="reStation.Decomp.Resources.r3000a_gte.slaspec" />
    <None Include="Resources\r3000a_gte.slaspec" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\reStation.Contracts\reStation.Contracts.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>$(ReStationLibDir)Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Retro">
      <HintPath>$(ReStationLibDir)Foundation.Retro.dll</HintPath>
    </Reference>
    <Reference Include="reEngine.Core">
      <HintPath>$(ReStationLibDir)reEngine.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
